<mxfile host="app.diagrams.net" agent="rhymer-docs" version="24.7.17">
  <diagram id="poem-pipeline" name="Конвейер стиха">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="&lt;b&gt;RHYMER - конвейер создания стихотворения&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#14161F;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="900" height="34" as="geometry" /></mxCell>
        <mxCell id="subtitle" value="Смысл: docs/sense-and-structure.html (ссылки вида §N) - Замысел: docs/stepsBeforeRhyming.txt - Маскировка: персона на входе (шаг 2) и де-ИИ на выходе (шаг 7)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#616A80;" vertex="1" parent="1"><mxGeometry x="60" y="42" width="1100" height="20" as="geometry" /></mxCell>

        <mxCell id="s0" value="ВХОД" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F2F4F9;strokeColor=#616A80;fontStyle=1;fontSize=14;fontColor=#14161F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="80" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="s01" value="&lt;b&gt;Повод&lt;/b&gt;&lt;br&gt;Событие, образ или строка-затравка. Без повода получится упражнение (§1). Если повода нет - берем его из блока актуализации" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="s0"><mxGeometry x="16" y="48" width="354" height="78" as="geometry" /></mxCell>
        <mxCell id="s02" value="&lt;b&gt;Форма&lt;/b&gt;&lt;br&gt;Метр, строфика, схема рифмовки, длина, язык" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="s0"><mxGeometry x="382" y="48" width="354" height="78" as="geometry" /></mxCell>
        <mxCell id="s03" value="&lt;b&gt;Ограничения&lt;/b&gt;&lt;br&gt;Табу-темы, обязательная лексика, кому адресован результат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="s0"><mxGeometry x="748" y="48" width="354" height="78" as="geometry" /></mxCell>

        <mxCell id="a" value="1. КАРТА СМЫСЛА - цепочка промптов (7 шагов замысла + проверка §1)" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#EEF1FD;strokeColor=#2B45CC;fontStyle=1;fontSize=14;fontColor=#1F35A6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="1120" height="228" as="geometry" /></mxCell>
        <mxCell id="a1" value="&lt;b&gt;1 Мысль&lt;/b&gt;&lt;br&gt;Один тезис в одном предложении. Управляющая идея (§22) + ответ на &quot;почему сейчас&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="16" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a2" value="&lt;b&gt;Четыре вопроса §1&lt;/b&gt;&lt;br&gt;Кто говорит - кому - почему именно сейчас - почему в этой форме. Нет ответа = нет стиха" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="291" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a3" value="&lt;b&gt;2 Палитра&lt;/b&gt;&lt;br&gt;Тон, градус напряжения, регистр лексики (§5, §7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="566" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a4" value="&lt;b&gt;3 Объекты&lt;/b&gt;&lt;br&gt;Лестница конкретизации, каналы чувств кроме зрения, резонансная деталь (§2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="841" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a5" value="&lt;b&gt;4 Переходы&lt;/b&gt;&lt;br&gt;Режим развития: медитативный / аргументативный / ассоциативный / каталог / кишотенкецу. Где волта (§4, §6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="16" y="138" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a6" value="&lt;b&gt;5 Лица&lt;/b&gt;&lt;br&gt;Говорящий, адресат, объект. Персона, а не автор (§5). Стыкуется с шагом 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="291" y="138" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a7" value="&lt;b&gt;6 Нить&lt;/b&gt;&lt;br&gt;Сквозной образ, лейтмотив, ключевое противопоставление (§2, §22)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="566" y="138" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="a8" value="&lt;b&gt;7 Панчлайн&lt;/b&gt;&lt;br&gt;Финал как резонанс, а не мораль. Объясняющая последняя строка запрещена (§6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="a"><mxGeometry x="841" y="138" width="263" height="78" as="geometry" /></mxCell>

        <mxCell id="map" value="&lt;b&gt;Артефакт: карта стиха (JSON)&lt;/b&gt; - 7 полей замысла + четыре ответа §1. Дальше по конвейеру идет карта, а не тема" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDE3FA;strokeColor=#2B45CC;fontSize=12;dashed=0;fontColor=#14161F;" vertex="1" parent="1"><mxGeometry x="330" y="770" width="580" height="52" as="geometry" /></mxCell>

        <mxCell id="b" value="2. ПЕРСОНА И СЦЕНА - маскировка на входе (сцены ниже - примеры приема, а не обязательный сценарий)" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F5EEFB;strokeColor=#7A3AA8;fontStyle=1;fontSize=14;fontColor=#5E2A85;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="884" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="b1" value="&lt;b&gt;Кто автор&lt;/b&gt;&lt;br&gt;Возраст, работа, усталость, что он потерял. Не поэт, а человек, который пишет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="b"><mxGeometry x="16" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="b2" value="&lt;b&gt;Сцена высказывания&lt;/b&gt;&lt;br&gt;Нужны место, время суток, поза и что перед глазами. Пример: метро в 23:40 после смены, окно, чужие лица. Сцена подбирается под замысел" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="b"><mxGeometry x="236" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="b3" value="&lt;b&gt;Идиолект&lt;/b&gt;&lt;br&gt;10-15 слов персоны и список слов, которых она не знает и не скажет" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="b"><mxGeometry x="456" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="b4" value="&lt;b&gt;Ситуация вместо задачи&lt;/b&gt;&lt;br&gt;Не &amp;quot;напиши стих про усталость&amp;quot;, а положение, в котором человек пишет: &amp;quot;едешь домой и пишешь в заметки последнее&amp;quot; - это один из вариантов, не шаблон" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="b"><mxGeometry x="676" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="b5" value="&lt;b&gt;Анти-паттерны&lt;/b&gt;&lt;br&gt;Запрет на LLM-маркеры: симметрия, мораль в финале, &quot;шепот ветра&quot;, &quot;танцует&quot;, итоговый вывод" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="b"><mxGeometry x="896" y="48" width="208" height="78" as="geometry" /></mxCell>

        <mxCell id="c" value="3. ГЕНЕРАЦИЯ - N вариантов (parallelization + best-of-N)" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#EAF5F0;strokeColor=#1D6547;fontStyle=1;fontSize=14;fontColor=#14523A;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1094" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="c1" value="&lt;b&gt;Промпт&lt;/b&gt;&lt;br&gt;Карта + персона + сцена. Без метарассуждений, задача не формулируется как задание" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6547;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="c"><mxGeometry x="16" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="c2" value="&lt;b&gt;N сэмплов&lt;/b&gt;&lt;br&gt;Разные режимы развития §6 и разная температура. Один прогон - одна гипотеза стиха" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6547;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="c"><mxGeometry x="291" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="c3" value="&lt;b&gt;Движок RHYMER&lt;/b&gt;&lt;br&gt;Силлабо-тоника: метрическая сетка, расстановка ударений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6547;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="c"><mxGeometry x="566" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="c4" value="&lt;b&gt;Рифма&lt;/b&gt;&lt;br&gt;Числовая оценка созвучий, схема ABAB / ABBA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D6547;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="c"><mxGeometry x="841" y="48" width="263" height="78" as="geometry" /></mxCell>

        <mxCell id="d" value="4. ОЦЕНКА - три независимых судьи" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#FAF3E4;strokeColor=#9A6A00;fontStyle=1;fontSize=14;fontColor=#7A5400;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1304" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="d1" value="&lt;b&gt;Формальный судья&lt;/b&gt;&lt;br&gt;Метр, ударения, рифма. Детерминированно, без модели" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6A00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="d"><mxGeometry x="16" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="d2" value="&lt;b&gt;Смысловой судья&lt;/b&gt;&lt;br&gt;Рубрика §11: 10 критериев по 0-3 балла. Отдельный вызов модели, не тот, что писал" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6A00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="d"><mxGeometry x="291" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="d3" value="&lt;b&gt;Детектор провалов §10&lt;/b&gt;&lt;br&gt;14 симптомов: названная эмоция, декоративный образ, объясняющий финал, инертный синтаксис" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6A00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="d"><mxGeometry x="566" y="48" width="263" height="78" as="geometry" /></mxCell>
        <mxCell id="d4" value="&lt;b&gt;Детектор ИИ-следа&lt;/b&gt;&lt;br&gt;Ровность, предсказуемость, глянец, вывод в конце, отсутствие шероховатости" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9A6A00;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="d"><mxGeometry x="841" y="48" width="263" height="78" as="geometry" /></mxCell>

        <mxCell id="sum" value="&lt;b&gt;Свод: балл + адресные претензии&lt;/b&gt; - не &quot;слабо&quot;, а &quot;строка 7: названная эмоция -&gt; заменить на предмет&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6E8C8;strokeColor=#9A6A00;fontSize=12;fontColor=#14161F;" vertex="1" parent="1"><mxGeometry x="330" y="1514" width="580" height="52" as="geometry" /></mxCell>

        <mxCell id="e" value="5. ЦИКЛ ПРАВКИ - evaluator-optimizer" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#FAEDE9;strokeColor=#9E3A26;fontStyle=1;fontSize=14;fontColor=#7E2C1C;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1628" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="e1" value="&lt;b&gt;Правка адресная&lt;/b&gt;&lt;br&gt;Чинить названный симптом по рецепту §10. Не переписывать текст целиком - иначе теряется то, что уже работало" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E3A26;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="e"><mxGeometry x="16" y="48" width="380" height="78" as="geometry" /></mxCell>
        <mxCell id="e2" value="&lt;b&gt;Память итераций&lt;/b&gt;&lt;br&gt;Что уже пробовали и чем кончилось, чтобы не ходить по кругу. Максимум 3 прохода" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E3A26;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="e"><mxGeometry x="408" y="48" width="380" height="78" as="geometry" /></mxCell>
        <mxCell id="edec" value="&lt;b&gt;Пороги взяты?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9E3A26;fontSize=12;fontColor=#14161F;" vertex="1" parent="e"><mxGeometry x="816" y="48" width="288" height="78" as="geometry" /></mxCell>

        <mxCell id="f" value="6. ОГРАНКА - протокол ревизии §11" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#EEF1FD;strokeColor=#2B45CC;fontStyle=1;fontSize=14;fontColor=#1F35A6;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="1838" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="f1" value="&lt;b&gt;Голова и хвост&lt;/b&gt;&lt;br&gt;Срезать первую строфу и 1-3 последние строки, сравнить с исходником" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="f"><mxGeometry x="16" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="f2" value="&lt;b&gt;Глаголы&lt;/b&gt;&lt;br&gt;Связки в действия, прилагательные пополам" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="f"><mxGeometry x="236" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="f3" value="&lt;b&gt;Абстракции&lt;/b&gt;&lt;br&gt;Каждое отвлеченное слово оплачено предшествующей деталью" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="f"><mxGeometry x="456" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="f4" value="&lt;b&gt;Разбивка строк&lt;/b&gt;&lt;br&gt;Переписать прозой, разбить заново, сравнить (§8). Перенос должен работать" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="f"><mxGeometry x="676" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="f5" value="&lt;b&gt;Звук&lt;/b&gt;&lt;br&gt;Гласные, скопления согласных, темп, паузы. Прочесть вслух целиком" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2B45CC;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="f"><mxGeometry x="896" y="48" width="208" height="78" as="geometry" /></mxCell>

        <mxCell id="g" value="7. ФИНАЛЬНАЯ МАСКИРОВКА - де-ИИ на выходе" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F5EEFB;strokeColor=#7A3AA8;fontStyle=1;fontSize=14;fontColor=#5E2A85;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="2048" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="g1" value="&lt;b&gt;Асимметрия&lt;/b&gt;&lt;br&gt;1-2 намеренных сбоя ритма или длины строки - как смысловой сигнал (§8), а не как брак" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="g"><mxGeometry x="16" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="g2" value="&lt;b&gt;Снять глянец&lt;/b&gt;&lt;br&gt;Убрать красивости, вернуть неудобное точное слово" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="g"><mxGeometry x="236" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="g3" value="&lt;b&gt;Убрать вывод&lt;/b&gt;&lt;br&gt;Если последняя строка объясняет предыдущие - удалить ее" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="g"><mxGeometry x="456" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="g4" value="&lt;b&gt;Вернуть идиолект&lt;/b&gt;&lt;br&gt;1-2 слова персоны из шага 2 обратно в текст" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="g"><mxGeometry x="676" y="48" width="208" height="78" as="geometry" /></mxCell>
        <mxCell id="g5" value="&lt;b&gt;Тест незнакомца §11&lt;/b&gt;&lt;br&gt;Работает ли текст без биографии автора и без пояснений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="g"><mxGeometry x="896" y="48" width="208" height="78" as="geometry" /></mxCell>

        <mxCell id="h" value="ВЫХОД" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F2F4F9;strokeColor=#616A80;fontStyle=1;fontSize=14;fontColor=#14161F;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="2258" width="1120" height="138" as="geometry" /></mxCell>
        <mxCell id="h1" value="&lt;b&gt;Стих&lt;/b&gt;&lt;br&gt;Финальный текст" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="h"><mxGeometry x="16" y="48" width="354" height="78" as="geometry" /></mxCell>
        <mxCell id="h2" value="&lt;b&gt;Карта смысла + отчет&lt;/b&gt;&lt;br&gt;Что чинили, по каким критериям, баллы до и после" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="h"><mxGeometry x="382" y="48" width="354" height="78" as="geometry" /></mxCell>
        <mxCell id="h3" value="&lt;b&gt;Лог версий&lt;/b&gt;&lt;br&gt;N черновиков, история правок, что отбросили и почему" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="h"><mxGeometry x="748" y="48" width="354" height="78" as="geometry" /></mxCell>

        <mxCell id="lib" value="БИБЛИОТЕКА (контекст промптов)" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#F7F8FB;strokeColor=#616A80;fontStyle=1;fontSize=12;fontColor=#14161F;align=left;spacingLeft=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="1220" y="480" width="280" height="962" as="geometry" /></mxCell>
        <mxCell id="l1" value="&lt;b&gt;§11 Рубрика&lt;/b&gt;&lt;br&gt;Повод, ставки, конкретика, фигуры, напряжение, поворот, голос, форма, финал, неожиданность" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="48" width="252" height="120" as="geometry" /></mxCell>
        <mxCell id="l2" value="&lt;b&gt;§10 Таблица провалов&lt;/b&gt;&lt;br&gt;14 симптомов -&gt; причина -&gt; рецепт правки. Основной вход для судьи и для правки" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="180" width="252" height="120" as="geometry" /></mxCell>
        <mxCell id="l3" value="&lt;b&gt;§6 Режимы развития, §4 волта&lt;/b&gt;&lt;br&gt;Как стих думает и где происходит перелом" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="312" width="252" height="120" as="geometry" /></mxCell>
        <mxCell id="l4" value="&lt;b&gt;§2, §3 Образ и фигуры&lt;/b&gt;&lt;br&gt;Лестница конкретизации, тенор и носитель, отказ от декоративных образов" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="444" width="252" height="120" as="geometry" /></mxCell>
        <mxCell id="l5" value="&lt;b&gt;§7, §8 Лексика, строка, звук&lt;/b&gt;&lt;br&gt;Регистр, остранение, перенос, цезура, паратаксис, ритмический перебой" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="576" width="252" height="120" as="geometry" /></mxCell>
        <mxCell id="l6" value="&lt;b&gt;stepsBeforeRhyming.txt&lt;/b&gt;&lt;br&gt;7 шагов замысла: Мысль, Палитра, Объекты, Переходы, Лица, Нить, Панчлайн" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="708" width="252" height="120" as="geometry" /></mxCell>
        <mxCell id="l7" value="&lt;b&gt;Словари RHYMER&lt;/b&gt;&lt;br&gt;Ударения, рифмы, частотность - для формальной оценки и для отлова клише" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA5C4;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="lib"><mxGeometry x="14" y="840" width="252" height="108" as="geometry" /></mxCell>

        <mxCell id="mask" value="&lt;b&gt;Правила маскировки&lt;/b&gt;&lt;br&gt;&lt;br&gt;0. Персона и сцена подбираются под замысел. Метро, смена, заметки - иллюстрация приема, а не обязательный сюжет.&lt;br&gt;1. Ситуация вместо задачи: описываем положение пишущего, а не выдаем задание.&lt;br&gt;2. У персоны есть тело и время: где сидит, что видит, сколько на часах.&lt;br&gt;3. У персоны есть запреты: слова, которых она не знает.&lt;br&gt;4. Никакой саморефлексии модели и никакого вывода в финале.&lt;br&gt;5. Шероховатость дороже гладкости: один сбой ритма лучше пяти ровных строф." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EEFB;strokeColor=#7A3AA8;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#14161F;" vertex="1" parent="1"><mxGeometry x="1220" y="1514" width="280" height="300" as="geometry" /></mxCell>

        <mxCell id="thr" value="&lt;b&gt;Пороги выхода из цикла&lt;/b&gt;&lt;br&gt;&lt;br&gt;Формальный балл &gt;= 0.8&lt;br&gt;Смысловой &gt;= 21 из 30&lt;br&gt;ИИ-след: не более 1 симптома&lt;br&gt;&lt;br&gt;Иначе итерация, максимум 3. Потом берем лучший вариант и помечаем слабые места в отчете." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAEDE9;strokeColor=#9E3A26;fontSize=11;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontColor=#14161F;" vertex="1" parent="1"><mxGeometry x="1220" y="1850" width="280" height="180" as="geometry" /></mxCell>

        <mxCell id="ed1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B45CC;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="s0" target="act"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B45CC;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="a" target="map"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A3AA8;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="map" target="b"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6547;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="b" target="c"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A6A00;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="c" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9A6A00;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="d" target="sum"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9E3A26;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="sum" target="e"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed8" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D6547;strokeWidth=2;endArrow=blockThin;endFill=1;fontSize=12;fontColor=#14523A;" edge="1" parent="1" source="edec" target="f"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed9" value="нет - вернуть в генерацию с адресными правками" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9E3A26;strokeWidth=2;endArrow=blockThin;endFill=1;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#7E2C1C;" edge="1" parent="1" source="e" target="c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="20" y="1697" /><mxPoint x="20" y="1163" /></Array></mxGeometry></mxCell>
        <mxCell id="ed10" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A3AA8;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="f" target="g"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed11" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#616A80;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="g" target="h"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="ed12" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA5C4;strokeWidth=1;endArrow=open;dashed=1;" edge="1" parent="1" source="lib" target="a"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed13" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA5C4;strokeWidth=1;endArrow=open;dashed=1;" edge="1" parent="1" source="lib" target="d"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed14" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9AA5C4;strokeWidth=1;endArrow=open;dashed=1;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lib" target="f"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1560" y="1346" /><mxPoint x="1560" y="1907" /></Array></mxGeometry></mxCell>
        <mxCell id="ed15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A3AA8;strokeWidth=1;endArrow=open;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mask" target="b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="1640" /><mxPoint x="1590" y="953" /></Array></mxGeometry></mxCell>
        <mxCell id="ed16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#7A3AA8;strokeWidth=1;endArrow=open;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mask" target="g"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ed17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#9E3A26;strokeWidth=1;endArrow=open;dashed=1;" edge="1" parent="1" source="thr" target="edec"><mxGeometry relative="1" as="geometry" /></mxCell>

      <mxCell id="act" value="0.5 АКТУАЛИЗАЦИЯ - поиск в интернете (опционально; может сам подсказать повод, если его нет)" style="swimlane;horizontal=1;startSize=36;html=1;rounded=1;arcSize=4;whiteSpace=wrap;fillColor=#E8F4F6;strokeColor=#0F7B8A;fontStyle=1;fontSize=14;fontColor=#0B5C68;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="1120" height="138" as="geometry" /></mxCell><mxCell id="act1" value="&lt;b&gt;Повестка&lt;/b&gt;&lt;br&gt;Что обсуждают прямо сейчас: новости, сезон, дата, погода. Окно - дни или недели; дата поиска фиксируется в карте" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B8A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="act"><mxGeometry x="16" y="48" width="208" height="78" as="geometry" /></mxCell><mxCell id="act2" value="&lt;b&gt;Наболевшее&lt;/b&gt;&lt;br&gt;Живые жалобы и боли: комментарии, форумы, треды. Берем формулировки людей, а не пересказ мнений" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B8A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="act"><mxGeometry x="236" y="48" width="208" height="78" as="geometry" /></mxCell><mxCell id="act3" value="&lt;b&gt;Живой язык&lt;/b&gt;&lt;br&gt;Как сейчас говорят: свежая лексика, обороты. И что уже затерто - сразу в стоп-лист клише" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B8A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="act"><mxGeometry x="456" y="48" width="208" height="78" as="geometry" /></mxCell><mxCell id="act4" value="&lt;b&gt;Выгорела ли тема&lt;/b&gt;&lt;br&gt;Если про это написали все - менять угол зрения или тему. Искать то, о чем молчат" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B8A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="act"><mxGeometry x="676" y="48" width="208" height="78" as="geometry" /></mxCell><mxCell id="act5" value="&lt;b&gt;Фильтр в образы&lt;/b&gt;&lt;br&gt;Повестка входит в стих деталями и фактами, а не тезисами. Иначе выйдет публицистика (§10, стих-тезис)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0F7B8A;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontColor=#14161F;" vertex="1" parent="act"><mxGeometry x="896" y="48" width="208" height="78" as="geometry" /></mxCell><mxCell id="ed1b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#2B45CC;strokeWidth=2;endArrow=blockThin;endFill=1;" edge="1" parent="1" source="act" target="a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ed1c" value="боль персоны берем из реальных формулировок" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0F7B8A;strokeWidth=1;endArrow=open;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#0B5C68;" edge="1" parent="1" source="act" target="b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="38" y="339" /><mxPoint x="38" y="953" /></Array></mxGeometry></mxCell></root>
    </mxGraphModel>
  </diagram>
</mxfile>